  text-decoration: none;
}

.gallery {
  margin-top: 72px;
  display: flex;
  gap: 24px;
  padding: 24px 4vw 32px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: 4vw;
  -webkit-overflow-scrolling: touch;
}

.photo {
  position: relative;
  flex: 0 0 min(72vw, 760px);
  height: calc(100svh - 140px);
  min-height: 320px;
  padding: 0;
  border: 0;
  background: white;
  cursor: zoom-in;
  scroll-snap-align: start;
}

.photo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.lens {
  position: absolute;
  bottom: 18px;
  right: 18px;
  width: 44px;
  height: 44px;
  padding: 11px;
  border-radius: 50%;
  background: white;
  color: #710b20;
  box-shadow: 0 2px 12px #0002;
}

.gallery::-webkit-scrollbar { height: 4px; }
.gallery::-webkit-scrollbar-thumb { background: #710b20; }

dialog {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100dvh;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 0;
  border: 0;
  background: white;
  color: #710b20;
}

dialog::backdrop { background: #0009; }

.toolbar {
  height: 74px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  border-bottom: 1px solid #eee;
}

.toolbar button {
  min-width: 44px;
  height: 44px;
  border: 1px solid #ddd;
  background: white;
  color: #710b20;
  font-size: 24px;
  cursor: pointer;
}

.toolbar button:disabled { opacity: .35; }

#close {
  position: absolute;
  right: 16px;
}

#level {
  min-width: 55px;
  text-align: center;
  font-size: 13px;
}

.viewport {
  height: calc(100dvh - 74px);
  overflow: auto;
  overscroll-behavior: contain;
}

.viewport img {
  display: block;
  width: 100%;
  max-width: none;
  height: auto;
  margin: 0 auto;
  cursor: zoom-in;
}

a:focus-visible,
button:focus-visible,
.gallery:focus-visible {
  outline: 2px solid #710b20;
  outline-offset: 4px;
}

@media (max-width: 650px) {
  header { height: 64px; }
  .menu { top: 64px; width: 100%; }

  .gallery {
    margin-top: 64px;
    padding: 16px 5vw 24px;
    gap: 14px;
    scroll-padding-inline: 5vw;
  }

  .photo {
    flex-basis: 86vw;
    height: calc(100svh - 120px);
    min-height: 300px;
  }
}
</style>
</head>

<body>
<header>
  <a class="logo" href="index.html" aria-label="Home De’ Francesco">
    <img src="assets/corona.jpeg" alt="De’ Francesco">
  </a>

  <button class="menu-button" id="menu-button"
    aria-label="Apri menu" aria-expanded="false" aria-controls="menu">
    <span></span>
    <span></span>
  </button>
</header>

<nav class="menu" id="menu" aria-label="Menu principale" hidden>
  <a href="index.html">home</a>
  <a href="demo.html" aria-current="page">demo</a>
</nav>

<main class="gallery" tabindex="0"
  aria-label="Galleria: scorri orizzontalmente per vedere le immagini">

  <button class="photo" aria-label="Ingrandisci la maglietta">
    <img src="assets/maglietta_intera.png" alt="Maglietta intera">
  </button>

  <button class="photo" aria-label="Ingrandisci l’etichetta ricamata">
    <img src="assets/etichetta_ricamata.png" alt="Etichetta ricamata">
  </button>

  <button class="photo" aria-label="Ingrandisci la coroncina ricamata">
    <img src="assets/coroncina_ricamata.png" alt="Coroncina ricamata">
  </button>

</main>

<dialog id="zoom" aria-label="Immagine ingrandita">
  <div class="toolbar">
    <button id="minus" aria-label="Riduci zoom">−</button>
    <output id="level" aria-live="polite">100%</output>
    <button id="plus" aria-label="Aumenta zoom">+</button>
    <button id="close" aria-label="Chiudi">×</button>
  </div>

  <div class="viewport" id="viewport">
    <img id="zoom-image" alt="">
  </div>
</dialog>

<script>
const menuButton = document.getElementById("menu-button");
const menu = document.getElementById("menu");

function closeMenu() {
  menu.hidden = true;
  menuButton.setAttribute("aria-expanded", "false");
  menuButton.setAttribute("aria-label", "Apri menu");
}

menuButton.addEventListener("click", () => {
  const open = menu.hidden;
  menu.hidden = !open;
  menuButton.setAttribute("aria-expanded", String(open));
  menuButton.setAttribute("aria-label", open ? "Chiudi menu" : "Apri menu");
});

document.addEventListener("click", event => {
  if (!menu.contains(event.target) && !menuButton.contains(event.target)) {
    closeMenu();
  }
});

const dialog = document.getElementById("zoom");
const image = document.getElementById("zoom-image");
const viewport = document.getElementById("viewport");
const levelText = document.getElementById("level");
const minus = document.getElementById("minus");
const plus = document.getElementById("plus");
let level = 100;

function setZoom(value) {
  level = Math.max(100, Math.min(400, value));
  image.style.width = level + "%";
  levelText.value = level + "%";
  minus.disabled = level === 100;
  plus.disabled = level === 400;
  image.style.cursor = level === 400 ? "zoom-out" : "zoom-in";
}

document.querySelectorAll(".photo").forEach(button => {
  button.insertAdjacentHTML("beforeend", `
    <svg class="lens" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="10" cy="10" r="6"></circle>
      <path d="M15 15L21 21M10 7V13M7 10H13"></path>
    </svg>
  `);

  button.addEventListener("click", () => {
    const source = button.querySelector("img");
    image.src = source.src;
    image.alt = source.alt;
    setZoom(100);
    dialog.showModal();
    viewport.scrollTo(0, 0);
    document.body.style.overflow = "hidden";
  });
});

plus.onclick = () => setZoom(level + 50);
minus.onclick = () => setZoom(level - 50);
document.getElementById("close").onclick = () => dialog.close();

dialog.addEventListener("close", () => {
  document.body.style.overflow = "";
});

image.addEventListener("click", event => {
  const rect = image.getBoundingClientRect();
  const x = (event.clientX - rect.left) / rect.width;
  const y = (event.clientY - rect.top) / rect.height;

  setZoom(level === 400 ? 100 : level + 100);

  requestAnimationFrame(() => {
    viewport.scrollLeft = x * image.clientWidth - viewport.clientWidth / 2;
    viewport.scrollTop = y * image.clientHeight - viewport.clientHeight / 2;
  });
});

const gallery = document.querySelector(".gallery");

gallery.addEventListener("keydown", event => {
  if (event.target !== gallery) return;

  if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
    event.preventDefault();
    gallery.scrollBy({
      left: (event.key === "ArrowRight" ? 1 : -1) * gallery.clientWidth * .85,
      behavior: "smooth"
    });
  }
});

document.addEventListener("keydown", event => {
  if (event.key === "Escape" && !menu.hidden) {
    closeMenu();
    menuButton.focus();
  }
});
</script>
</body>
</html>
